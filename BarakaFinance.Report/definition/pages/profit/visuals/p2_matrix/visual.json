{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.5.0/schema.json",
  "name": "p2_matrix",
  "position": {
    "x": 20,
    "y": 310,
    "z": 7000,
    "width": 600,
    "height": 180,
    "tabOrder": 7000
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Segment"
                    }
                  },
                  "Property": "Segment"
                }
              },
              "queryRef": "Segment.Segment",
              "nativeQueryRef": "Segment"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Discount Band"
                    }
                  },
                  "Property": "Discount Band"
                }
              },
              "queryRef": "Discount Band.Discount Band",
              "nativeQueryRef": "Discount Band"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Key Measures"
                    }
                  },
                  "Property": "Profit Margin"
                }
              },
              "queryRef": "Key Measures.Profit Margin",
              "nativeQueryRef": "Profit Margin"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Profit margin by segment and discount band'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
